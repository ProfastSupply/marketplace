<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_create_invoice" model="ir.ui.view">
        <field name="name">stock.picking.form.create.invoice</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            
            <!-- Add Create Invoice button before Validate button -->
            <button name="action_confirm" position="before">
                <button name="action_create_invoice"
                        string="Create Invoice"
                        type="object"
                        class="btn-info"
                        confirm="Are you sure you want to create an invoice?"
                        invisible="state != 'done' or picking_type_code != 'outgoing' or not sale_id"/>
            </button>
            
            <!-- Add sale_id and x_po_origin after partner_id, hide origin -->
            <field name="partner_id" position="after">
                <field name="sale_id" 
                       readonly="1" 
                       invisible="not sale_id"/>
                <field name="x_po_origin" 
                       readonly="1" 
                       invisible="not x_po_origin"/>
            </field>
            
            <!-- Hide origin field -->
            <field name="origin" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            
        </field>
    </record>
</odoo>
