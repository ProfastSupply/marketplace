<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_regenerate_lines" model="ir.ui.view">
        <field name="name">account.move.form.regenerate.lines</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            
            <!-- Add Regenerate Lines button -->
            <xpath expr="//button[@name='action_post']" position="before">
                <button name="action_regenerate_invoice_lines"
                        string="Regenerate Lines"
                        type="object"
                        class="btn-secondary"
                        confirm="This will delete existing lines and rebuild from delivered quantities. Continue?"
                        invisible="state != 'draft' or move_type not in ('out_invoice', 'out_refund') or not invoice_origin"/>
            </xpath>
            
        </field>
    </record>
</odoo>
