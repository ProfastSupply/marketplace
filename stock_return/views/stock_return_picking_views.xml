<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_return_picking_form_max_qty" model="ir.ui.view">
        <field name="name">stock.return.picking.form.max.qty</field>
        <field name="model">stock.return.picking</field>
        <field name="inherit_id" ref="stock.view_stock_return_picking_form"/>
        <field name="arch" type="xml">
            
            <!-- Make move_quantity visible with label -->
            <xpath expr="//field[@name='product_return_moves']//field[@name='move_quantity']" position="attributes">
                <attribute name="column_invisible"/>
                <attribute name="string">Qty Delivered</attribute>
            </xpath>
            
            <!-- Replace entire footer -->
            <xpath expr="//footer" position="replace">
                <group style="width: 100%;">
                    <group>
                        <button name="action_return_max_quantities" 
                                string="Return Max Quantities" 
                                type="object" 
                                class="btn-success"/>
                    </group>
                    <group style="text-align: right;">
                        <button name="action_create_returns" 
                                string="Return Inputted Quantities" 
                                type="object" 
                                class="btn-primary"/>
                    </group>
                </group>
                <footer>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel" 
                            data-hotkey="x"/>
                </footer>
            </xpath>
            
        </field>
    </record>
</odoo>
