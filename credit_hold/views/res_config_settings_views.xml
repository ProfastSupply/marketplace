<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_credit_hold" model="ir.ui.view">
        <field name="name">res.config.settings.view.credit.hold</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!--
                Append a Credit Hold block at the bottom of the Sales settings app,
                after the Invoicing block. Odoo 18 uses app/block/setting no divs.
            -->
            <xpath expr="//app[@name='sale_management']/block[@name='invoicing_setting_container']" position="after">
                <block title="Credit Hold" name="credit_hold_setting_container">
                    <setting string="Credit Hold Approvers"
                             help="Any one of these users can approve or reject a Sale Order blocked by a credit hold. All will receive an activity the moment a new order is blocked, so whoever is available can act immediately.">
                        <field name="credit_hold_approver_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </setting>
                    <setting string="Credit Hold Notification Recipient"
                             help="This person receives an activity whenever a customer account is automatically placed on hold or released.">
                        <field name="credit_hold_notify_user_id"
                               options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
