<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="credit_hold_so_approval_rule" model="studio.approval.rule">
        <field name="name">Credit Hold</field>
        <field name="message">Customer is on a Credit Hold -- review balance vs. limit before approving.</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="method">action_confirm</field>
        <field name="conditional">True</field>
        <field name="domain">[('partner_id.x_account_hold', '=', True)]</field>
        <field name="active">True</field>
    </record>
</odoo>
