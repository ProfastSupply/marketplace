<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Invoice Form View - Add Cost/Profit Fields -->
    <record id="view_invoice_form_profitability" model="ir.ui.view">
        <field name="name">account.move.form.profitability</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            
            <!-- Add fields in Other Info tab after Marketing section -->
            <xpath expr="//group[@id='other_tab_group']" position="inside">
                <group string="Sales Data" name="sales_data_group" 
                       groups="account.group_account_manager"
                       invisible="move_type not in ('out_invoice', 'out_refund')">
                    <field name="invoice_cost" readonly="1" 
                           widget="monetary" 
                           options="{'currency_field': 'currency_id'}"/>
                    <field name="invoice_profit" readonly="1" 
                           widget="monetary" 
                           options="{'currency_field': 'currency_id'}"/>
                </group>
            </xpath>
            
        </field>
    </record>

    <!-- Invoice List View - Add Profit Column -->
    <record id="view_invoice_tree_profitability" model="ir.ui.view">
        <field name="name">account.move.tree.profitability</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            
            <!-- Add profit column as last column -->
            <xpath expr="//list" position="inside">
                <field name="invoice_profit" 
                       optional="show" 
                       sum="Total Profit"
                       groups="account.group_account_manager"
                       widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
            </xpath>
            
        </field>
    </record>

</odoo>
