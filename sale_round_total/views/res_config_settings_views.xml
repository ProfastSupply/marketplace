<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Adds a "Total Rounding" block to Sales > Configuration > Settings.
        Uses the Odoo 18 <block> / <setting> structure.
        Inserted after the existing "Pricing" block.
    -->
    <record id="res_config_settings_view_form_sale_rounding" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sale.rounding</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pricing_setting_container']" position="after">
                <block title="Total Rounding" id="sale_rounding_setting_container">
                    <setting id="sale_rounding_increment"
                             string="Rounding Increment"
                             help="Automatically round the after-tax total to this increment when confirming an order. Unit prices are adjusted proportionally across all lines.">
                        <field name="sale_rounding_increment" widget="radio"/>
                    </setting>
                    <setting id="sale_rounding_direction"
                             string="Rounding Direction"
                             help="Round Up: total never decreases (default). Nearest: round to whichever boundary is closer. Round Down: total never increases.">
                        <field name="sale_rounding_direction" widget="radio"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
